[gd_scene format=3 uid="uid://dscjbe6qbr63g"]

[sub_resource type="GDScript" id="GDScript_uchyk"]
script/source = "@tool
extends \"res://addons/webapi/webapi.gd\"

func handle_request(data: Dictionary) -> String:
		
	# print(data[\"path\"])
	
	match data[\"path\"]:
		\"/api/time\":
			print(\"time!\")
			return Time.get_datetime_string_from_system()
		\"/api/ping\":
			print(\"ping!\")
			return \"pong!\"
		\"/api/neofetch\":
			print(\"neofetch!\")
			var output = []
			OS.execute(\"fastfetch\", [], output)
			return output[0]
		\"/api/quit\":
			print(\"quit!\")
			get_tree().quit(0)
			return \"byebye!\"
		_:
			return \"OK\"
"

[node name="Control" type="Control" unique_id=379752791]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

